# Which environment's apps and account service this desk belongs to.
# development | sandbox | production
VITE_ENV=development

# The account service (the desk's only backend) and the account app people are sent to.
VITE_ACCOUNT_API_URL=https://dev-account-az.elva.ai/api/v2
VITE_ACCOUNT_APP_URL=https://account-web-dev.elva.ai

# The desk's registered client id in the account admin (Platform → Client apps).
VITE_OAUTH_CLIENT_ID=desk

# silent | error | warn | info | debug. Override at runtime with localStorage 'elva:log' or ?log=.
VITE_LOG_LEVEL=debug

# Idle lock. Soft lock hides window contents and asks for a click. Hard lock ends the session.
VITE_SOFT_LOCK_MINUTES=15
VITE_HARD_LOCK_HOURS=12
