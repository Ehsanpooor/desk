{
  "name": "elva-desk-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.10.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @elva/desk-sdk build && pnpm --filter elva-desk dev",
    "dev:example": "pnpm --filter elva-desk-example-hello dev",
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  }
}
